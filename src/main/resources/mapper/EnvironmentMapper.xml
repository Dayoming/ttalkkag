<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.apitester.ttalkkag.mapper.EnvironmentMapper">
    <select id="findByUserId" resultType="Environment">
        SELECT * FROM environment WHERE user_id = #{userId}
    </select>

    <insert id="insertEnvironment">
        INSERT INTO environment (user_id, name, is_default)
        VALUES (#{userId}, #{name}, #{isDefault})
    </insert>

    <delete id="deleteEnvironment">
        DELETE FROM environment WHERE id = #{id}
    </delete>
</mapper>
